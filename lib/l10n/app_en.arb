    "description": "Toolbar tooltip: switch light/dark theme."
  },
  "toolbarSettings": "Settings",
  "@toolbarSettings": {
    "description": "Toolbar tooltip: open settings."
  },
  "comingSoon": "Coming soon",
  "@comingSoon": {
    "description": "Message for toolbar buttons that are not built yet."
  },
  "emptyState": "Open a JSON file",
  "@emptyState": {
    "description": "Shown in the content area when no document is loaded."
  },
  "openFailedTitle": "Can't open {fileName}",
  "@openFailedTitle": {
    "description": "Error dialog title when a file cannot be opened.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "invalidJsonPosition": "Line {line}, column {column}: {message}",
  "@invalidJsonPosition": {
    "description": "Where the JSON is invalid. message is the parser's English message.",
    "placeholders": {
      "line": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "message": {
        "type": "String"
      }
    }
  },
  "fileNotText": "The file is not UTF-8 text.",
  "@fileNotText": {
    "description": "Error when the chosen file cannot be decoded as UTF-8."
  },
  "ok": "OK",
  "@ok": {
    "description": "Button that closes a dialog."
  },
  "openFailed": "Can't open the file",
  "@openFailed": {
    "description": "Error dialog title when the open panel itself fails."
  },
  "saveFailedTitle": "Can't save {fileName}",
  "@saveFailedTitle": {
    "description": "Error dialog title when a file cannot be written.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "saveFailed": "Can't save the file",
  "@saveFailed": {
    "description": "Error dialog title when the save panel itself fails."
  },
  "untitled": "Untitled",
  "@untitled": {
    "description": "Title of a new document that has not been saved yet."
  },
  "editedTitle": "{fileName} — Edited",
  "@editedTitle": {
    "description": "Document title while it has unsaved changes (macOS style).",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "unsavedTitle": "Do you want to save the changes made to “{fileName}”?",
  "@unsavedTitle": {
    "description": "Unsaved-changes prompt title.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "unsavedMessage": "Your changes will be lost if you don't save them.",
  "@unsavedMessage": {
    "description": "Unsaved-changes prompt body."
  },
  "save": "Save",
  "@save": {
    "description": "Button: save the document."
  },
  "dontSave": "Don't Save",
  "@dontSave": {
    "description": "Button: discard unsaved changes."
  },
  "cancel": "Cancel",
  "@cancel": {
    "description": "Button: cancel the action."
  },
  "unknownError": "An unknown error occurred.",
  "@unknownError": {
    "description": "Dialog body when the system gives no error message."
  }
}
