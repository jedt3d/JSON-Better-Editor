{
  "@@locale": "en",
  "appTitle": "JSON Better Editor",
  "@appTitle": {
    "description": "Application name, shown as the window title."
  },
  "toolbarNew": "New",
  "@toolbarNew": {
    "description": "Toolbar tooltip: new document."
  },
  "toolbarOpen": "Open",
  "@toolbarOpen": {
    "description": "Toolbar tooltip: open a .json file."
  },
  "toolbarSearch": "Search",
  "@toolbarSearch": {
    "description": "Toolbar tooltip: search keys and values."
  },
  "toolbarLayoutText": "Text only",
  "@toolbarLayoutText": {
    "description": "Toolbar tooltip: show only the Text pane."
  },
  "toolbarLayoutNode": "Node only",
  "@toolbarLayoutNode": {
    "description": "Toolbar tooltip: show only the Node pane."
  },
  "toolbarLayoutSplit": "Split view",
  "@toolbarLayoutSplit": {
    "description": "Toolbar tooltip: show Text and Node side by side."
  },
  "toolbarLanguage": "Language",
  "@toolbarLanguage": {
    "description": "Toolbar tooltip: switch UI language."
  },
  "toolbarTheme": "Theme",
  "@toolbarTheme": {
    "description": "Toolbar tooltip: switch light/dark theme."
  },
  "toolbarSettings": "Settings",
  "@toolbarSettings": {
    "description": "Toolbar tooltip: open settings."
  },
  "comingSoon": "Coming soon",
  "@comingSoon": {
    "description": "Message for toolbar buttons that are not built yet."
  },
  "emptyState": "Open a JSON file",
  "@emptyState": {
    "description": "Shown in the content area when no document is loaded."
  },
  "openFailedTitle": "Can't open {fileName}",
  "@openFailedTitle": {
    "description": "Error dialog title when a file cannot be opened.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "invalidJsonPosition": "Line {line}, column {column}: {message}",
  "@invalidJsonPosition": {
    "description": "Where the JSON is invalid. message is the parser's English message.",
    "placeholders": {
      "line": {
        "type": "int"
      },
      "column": {
        "type": "int"
      },
      "message": {
        "type": "String"
      }
    }
  },
  "fileNotText": "The file is not UTF-8 text.",
  "@fileNotText": {
    "description": "Error when the chosen file cannot be decoded as UTF-8."
  },
  "ok": "OK",
  "@ok": {
    "description": "Button that closes a dialog."
  },
  "openFailed": "Can't open the file",
  "@openFailed": {
    "description": "Error dialog title when the open panel itself fails."
  },
  "saveFailedTitle": "Can't save {fileName}",
  "@saveFailedTitle": {
    "description": "Error dialog title when a file cannot be written.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "saveFailed": "Can't save the file",
  "@saveFailed": {
    "description": "Error dialog title when the save panel itself fails."
  },
  "untitled": "Untitled",
  "@untitled": {
    "description": "Title of a new document that has not been saved yet."
  },
  "editedTitle": "{fileName} — Edited",
  "@editedTitle": {
    "description": "Document title while it has unsaved changes (macOS style).",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "unsavedTitle": "Do you want to save the changes made to “{fileName}”?",
  "@unsavedTitle": {
    "description": "Unsaved-changes prompt title.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "unsavedMessage": "Your changes will be lost if you don't save them.",
  "@unsavedMessage": {
    "description": "Unsaved-changes prompt body."
  },
  "save": "Save",
  "@save": {
    "description": "Button: save the document."
  },
  "dontSave": "Don't Save",
  "@dontSave": {
    "description": "Button: discard unsaved changes."
  },
  "cancel": "Cancel",
  "@cancel": {
    "description": "Button: cancel the action."
  },
  "searchHint": "Search keys and values",
  "@searchHint": {
    "description": "Placeholder in the search field."
  },
  "searchCount": "{current} of {total}",
  "@searchCount": {
    "description": "Which match is selected, e.g. 2 of 7.",
    "placeholders": {
      "current": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },
  "searchNoResults": "No results",
  "@searchNoResults": {
    "description": "Shown when the search text is not found."
  },
  "searchNext": "Next match (⌘G)",
  "@searchNext": {
    "description": "Tooltip of the next-match button."
  },
  "searchPrevious": "Previous match (⇧⌘G)",
  "@searchPrevious": {
    "description": "Tooltip of the previous-match button."
  },
  "searchClose": "Close search",
  "@searchClose": {
    "description": "Tooltip of the button that closes the search field."
  },
  "validateValid": "Valid JSON",
  "@validateValid": {
    "description": "Title of the Validate JSON result when the text is valid."
  },
  "validateValidMessage": "The document is valid JSON.",
  "@validateValidMessage": {
    "description": "Body of the Validate JSON result when the text is valid."
  },
  "validateInvalid": "Invalid JSON",
  "@validateInvalid": {
    "description": "Title of the Validate JSON result when the text has an error."
  },
  "goToLineTitle": "Go to Line",
  "@goToLineTitle": {
    "description": "Title of the Go to Line dialog."
  },
  "goToLineHint": "Line number (1–{count})",
  "@goToLineHint": {
    "description": "Placeholder in the Go to Line field.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "goToLineGo": "Go",
  "@goToLineGo": {
    "description": "Button that moves to the line."
  },
  "fileChangedTitle": "“{fileName}” was changed by another program",
  "@fileChangedTitle": {
    "description": "Title when the open file changed on disk.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "fileChangedMessage": "Reload it from disk, or keep the version shown here?",
  "@fileChangedMessage": {
    "description": "Body when the open file changed on disk and there are no unsaved edits."
  },
  "fileChangedDropEdits": "Reloading it drops your unsaved changes. Reload it from disk, or keep your version?",
  "@fileChangedDropEdits": {
    "description": "Body when the open file changed on disk and there are unsaved edits."
  },
  "reload": "Reload",
  "@reload": {
    "description": "Button: read the file again from disk."
  },
  "keepMine": "Keep Mine",
  "@keepMine": {
    "description": "Button: keep the version shown in the editor."
  },
  "fileDeletedTitle": "“{fileName}” was moved or deleted",
  "@fileDeletedTitle": {
    "description": "Title when the open file is no longer on disk.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "fileDeletedMessage": "The document stays open. Save writes it again.",
  "@fileDeletedMessage": {
    "description": "Body when the open file is no longer on disk."
  },
  "overwriteChangedTitle": "“{fileName}” changed on disk since you opened it",
  "@overwriteChangedTitle": {
    "description": "Title when saving over a file that another program changed.",
    "placeholders": {
      "fileName": {
        "type": "String"
      }
    }
  },
  "overwriteChangedMessage": "Saving replaces the other program's changes.",
  "@overwriteChangedMessage": {
    "description": "Body when saving over a file that another program changed."
  },
  "overwrite": "Overwrite",
  "@overwrite": {
    "description": "Button: save over the changed file."
  },
  "unknownError": "An unknown error occurred.",
  "@unknownError": {
    "description": "Dialog body when the system gives no error message."
  }
}
